# exo worker node (M1). Copy to peopleconnect/local.env and edit. Loaded by run-exo.sh.
EXO_ZENOH_NAMESPACE=peopleconnect-llm-grid
# nodes under this many GB of RAM are skipped by automatic placement (0 = off)
EXO_MIN_NODE_MEMORY_GB=16
# continuous batching slots per model; 4 on 32 GB nodes, 2 on 16 GB, 1 on 8 GB
EXO_MAX_CONCURRENT_REQUESTS=4
# extra flags for exo, for example "-v"
EXO_EXTRA_ARGS=
