# exo coordinator (Intel i9). Copy to peopleconnect/local.env and edit. Loaded by run-exo.sh.
EXO_ZENOH_NAMESPACE=peopleconnect-llm-grid
EXO_MIN_NODE_MEMORY_GB=16
# coordinator only: no model shards, no downloads, always wins the master election
EXO_EXTRA_ARGS="--no-worker --no-downloads --force-master"
